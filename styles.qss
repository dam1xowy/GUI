QMainWindow { 
    background-color: #060906; 
}

QTabWidget::pane {
    border: 1px solid #1f331f;
    background-color: #060906;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #0b140b;
    color: #00FF66;
    border: 1px solid #1f331f;
    padding: 9px 18px;
    font-family: "Consolas", "Courier New", monospace;
    font-weight: bold;
    font-size: 9pt;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin-right: 3px;
}

QTabBar::tab:selected {
    background-color: #122212;
    border-bottom-color: #122212;
    color: #33ff88;
}

QLabel { 
    color: #00FF66; 
    font-family: "Consolas", "Courier New", monospace; 
    font-size: 9pt; 
}

QProgressBar { 
    border: 1px solid #00aa44; 
    background: #0b140b; 
    text-align: center; 
    color: white; 
    font-family: "Consolas", "Courier New", monospace;
    font-size: 8pt;
    border-radius: 3px;
    height: 14px;
}

QProgressBar::chunk { 
    background-color: #00FF66; 
    border-radius: 2px; 
}

QFrame { 
    border: 1px solid #1f331f; 
    background-color: #0a0f0a; 
    border-radius: 6px;
}

QTableWidget, QTreeView, QTextEdit {
    background-color: #050805;
    color: #00FF66;
    gridline-color: #1f331f;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
    border: 1px solid #1f331f;
}

QHeaderView::section {
    background-color: #0f1f0f;
    color: #00FF66;
    border: 1px solid #1f331f;
    padding: 4px;
}

QTreeView::item:selected {
    background-color: #162a16;
    color: #33ff88;
}

QLineEdit {
    background-color: #0b140b;
    color: #00FF66;
    border: 1px solid #00FF66;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
    padding: 6px;
    border-radius: 4px;
}

QPushButton {
    background-color: #0b140b;
    color: #00FF66;
    border: 1px solid #00FF66;
    font-family: "Consolas", "Courier New", monospace;
    font-weight: bold;
    padding: 7px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #162a16;
    color: #33ff88;
}

QSlider::groove:horizontal {
    border: 1px solid #1f331f;
    height: 6px;
    background: #0b140b;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #00FF66;
    border: 1px solid #00aa44;
    width: 14px;
    margin: -4px 0;
    border-radius: 3px;
}